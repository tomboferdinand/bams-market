{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    //"baseUrl": "./",
    "incremental": false,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "jest",
      "node",
      "multer"
    ],
    "esModuleInterop": true
  }
}
