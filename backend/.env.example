# Copier ce fichier en ".env" puis remplacer les valeurs d'exemple.
# Ne JAMAIS publier le vrai fichier .env (il est exclu par .gitignore).

# --- Serveur ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Adresse du site (frontend) autorisée à appeler l'API, et utilisée dans les liens des e-mails
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# --- Base de données (PostgreSQL) -------------------------------------------
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/bams_market?schema=public"

# --- Authentification -------------------------------------------------------
# Longue chaîne aléatoire, propre à chaque environnement
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=1d
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# --- Compte administrateur (utilisé une seule fois par `npm run create-admin`) ---
# Après la création, supprimer ADMIN_PASSWORD de ce fichier.
ADMIN_EMAIL=admin@exemple.mg
ADMIN_PHONE=0340000000
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Bams
ADMIN_PASSWORD=ChangezMoi123

# --- E-mails (vérification, mot de passe oublié, activation de rôle) -------------
# Sans SMTP configuré, les liens sont affichés dans la console (mode développement).
SMTP_HOST=smtp.exemple.com
SMTP_PORT=587
SMTP_USER=compte@exemple.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM="Bam'S Market <compte@exemple.com>"

# --- Photos des produits (Cloudinary) ----------------------------------------
CLOUDINARY_CLOUD_NAME=nom-du-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=secret-cloudinary

# --- Paiement et retraits ----------------------------------------------------
# "simulation" : paiement simulé (démonstration, tests). "goalpay" : paiement réel.
PAYMENT_MODE=simulation
PAYOUT_MODE=simulation
GOALPAY_API_URL=https://exemple-goalpay.invalid
GOALPAY_ACCESS_KEY=cle-goalpay
GOALPAY_WEBHOOK_SECRET=secret-webhook-goalpay

# --- Règles métier (valeurs par défaut) --------------------------------------
COMMISSION_PERCENT=10
DELIVERY_FEE=2000
MIN_ORDER_AMOUNT=2000
PAYMENT_EXPIRATION_MINUTES=10
ORDER_UNPAID_EXPIRATION_MINUTES=30
EXPIRY_SWEEP_SECONDS=60
DELIVERY_MAX_ACTIVE_MISSIONS=3
DELIVERY_MAX_CONFIRM_ATTEMPTS=5
WALLET_HOLD_HOURS=0
PAYOUT_MIN_AMOUNT=1000
PAYOUT_MAX_AMOUNT=500000
PAYOUT_DAILY_MAX_AMOUNT=1000000
PAYOUT_DAILY_MAX_COUNT=5
PAYOUT_SIM_FEE_PERCENT=2
