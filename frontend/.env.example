# Copier ce fichier en ".env.local" (exclu du dépôt par .gitignore).

# Adresse de l'API backend (préfixe /api compris)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# En ligne seulement (site et API sur deux adresses différentes) : mettre NEXT_PUBLIC_API_URL=/api
# et indiquer ici l'adresse du backend, sans /api. Le site transmet alors les appels /api/... au backend.
# BACKEND_URL=https://adresse-du-backend.exemple

# Adresse de contact de l'administration, affichée au client après une livraison échouée (facultatif)
NEXT_PUBLIC_SUPPORT_EMAIL=support@exemple.mg
